def create_sim_scene(sdf_path, shape_type, half_extent, half_extent_y=None,
                      object_model_name="object", object_pos=None, object_target=None,
                      sim_time_step=0.0001, render=False, meshcat=None, run_tag=None,
                      camera_model=None):
    builder = DiagramBuilder()
    plant, sg = AddMultibodyPlantSceneGraph(builder, time_step=sim_time_step)
    parser = Parser(plant)
    parser.AddModelsFromUrl("file://" + os.path.abspath(ROBOT_URDF_PATH))
    parser.AddModelsFromUrl("file://" + os.path.abspath(sdf_path))
    plant.WeldFrames(
        plant.world_frame(),
        plant.GetFrameByName("panda_link0", plant.GetModelInstanceByName("panda")),
        ROBOT_BASE_OFFSET)
    plant.Finalize()

    # [Optional diagnostic — uncomment to identify a precise geometry on a
    #  wrist link, see list_body_collision_geometries]:
    # list_body_collision_geometries(plant, sg, "panda_link8")

    # ── Excludes the links listed in WRIST_LINKS_NO_OBJECT_COLLISION from
    # any collision with the object — see that constant's comment at the
    # top of the file (default: all 4 wrist links).
    try:
        obj_model = plant.GetModelInstanceByName(object_model_name)
        obj_body = None
        for bi in plant.GetBodyIndices(obj_model):
            b = plant.get_body(bi)
            if b.name() != "world":
                obj_body = b
                break
        if obj_body is not None:
            obj_geoms = plant.GetCollisionGeometriesForBody(obj_body)
            for link_name in WRIST_LINKS_NO_OBJECT_COLLISION:
                try:
                    link_body = plant.GetBodyByName(link_name)
                    link_geoms = plant.GetCollisionGeometriesForBody(link_body)
                    if link_geoms and obj_geoms:
                        sg.collision_filter_manager().Apply(
                            CollisionFilterDeclaration().ExcludeBetween(
                                GeometrySet(link_geoms), GeometrySet(obj_geoms)))
                except RuntimeError:
                    pass
            print(f"[Scene] Wrist collisions ↔ {object_model_name} excluded "
                  f"({', '.join(WRIST_LINKS_NO_OBJECT_COLLISION)})")
    except Exception as e:
        print(f"[Scene] ⚠ collision exclusion not applied ({e}) — "
              f"check your Drake version if contact looks incorrect.")

    print("Positions:", plant.num_positions(), " Velocities:", plant.num_velocities())

    best_q7 = [0.0, -0.3, 0.0, -2.2, 0.0, 2.0, 0.0]
    for name, val in zip(
            ["panda_joint1", "panda_joint2", "panda_joint3", "panda_joint4",
             "panda_joint5", "panda_joint6", "panda_joint7"], best_q7):
        plant.GetJointByName(name).set_default_angle(val)

    if render and meshcat is not None:
        AddDefaultVisualization(builder=builder, meshcat=meshcat)

    ctrl = builder.AddNamedSystem("PushController", PushController(
        plant, best_q7, shape_type=shape_type, half_extent=half_extent,
        half_extent_y=half_extent_y, object_model_name=object_model_name,
        object_pos=object_pos, object_target=object_target, run_tag=run_tag,
        camera_model=camera_model))
    des = builder.AddNamedSystem("DesiredPos", ConstantVectorSource(best_q7))

    builder.Connect(plant.get_state_output_port(), ctrl.GetInputPort("Current_state"))
    builder.Connect(ctrl.GetOutputPort("tau_u"), plant.GetInputPort("applied_generalized_force"))
    builder.Connect(des.get_output_port(), ctrl.GetInputPort("Desired_state"))
    builder.Connect(plant.get_contact_results_output_port(), ctrl.GetInputPort("contact_results"))

    logger = LogVectorOutput(plant.get_state_output_port(), builder)
    logger.set_name("State logger")
    return builder.Build(), logger, best_q7, ctrl


def run_trial(sdf_path, shape_type, half_extent, half_extent_y=None,
              object_model_name="object", object_pos=None, object_target=None,
              sim_time=25.0, render=False, sim_time_step=0.0001, run_tag=None,
              camera_model=CameraModel(freeze_after_first_capture=True, noise_std_m=0.003)):
    meshcat = None
    if render:
        meshcat = StartMeshcat()
        meshcat.Delete()
        meshcat.DeleteAddedControls()

    diagram, logger, best_q7, ctrl = create_sim_scene(
        sdf_path, shape_type, half_extent, half_extent_y=half_extent_y,
        object_model_name=object_model_name, object_pos=object_pos,
        object_target=object_target, sim_time_step=sim_time_step,
        render=render, meshcat=meshcat, run_tag=run_tag, camera_model=camera_model)

    sim = Simulator(diagram)
    sim.Initialize()
    if render:
        sim.set_target_realtime_rate(1.0)

    try:
        if render:
            meshcat.StartRecording()
        sim.AdvanceTo(sim_time)
        if render:
            meshcat.PublishRecording()
    except Exception as e:
        print(f"[run_trial] failed: {e}")
        return {"shape": shape_type, "success": False, "error": str(e),
                "final_dist_mm": float("nan"), "completion_time_s": None,
                "drake_contact_pct": 0.0}

    ctrl.save_force_plot()
    ctrl.save_trajectory_plot()

    # Recompute final_dist_mm from the REAL final simulation state —
    # ctrl._last_dist is refreshed on every _update() tick regardless of
    # state (see the comment in _update), but recomputing it directly from
    # the diagram's final context here is the most robust source of
    # truth: it doesn't depend on any controller-internal bookkeeping at
    # all, just the actual final object pose.
    final_ctx = ctrl.plant.GetMyContextFromRoot(sim.get_context())
    final_q = ctrl.plant.GetPositions(final_ctx)
    final_obj_xy = ctrl._get_object_xy(final_q)
    true_final_dist_mm = float(np.linalg.norm(final_obj_xy - ctrl.object_target) * 1000)

    metrics = ctrl.get_metrics()
    metrics["final_dist_mm"] = true_final_dist_mm
    return metrics


