def list_body_collision_geometries(plant, scene_graph, body_name):
    """
    Lists a body's collision geometries (name, type, local pose) to
    precisely identify an off-center geometry (e.g. panda_link8's sphere)
    without having to reread the URDF. Call after plant.Finalize(). The
    exact API (GetPoseInFrame / X_FG depending on Drake version) may vary
    slightly — adapt if needed.
    Usage: list_body_collision_geometries(plant, sg, "panda_link8")
    """
    body = plant.GetBodyByName(body_name)
    geoms = plant.GetCollisionGeometriesForBody(body)
    inspector = scene_graph.model_inspector()
    print(f"\n[Diag] Collision geometries of {body_name} ({len(geoms)}):")
    for gid in geoms:
        shape = inspector.GetShape(gid)
        name = inspector.GetName(gid)
        try:
            X_BG = inspector.GetPoseInFrame(gid)
            pose_str = np.round(X_BG.translation(), 4)
        except Exception:
            pose_str = "?"
        print(f"  - {name}: {type(shape).__name__}  local_pose={pose_str}")


