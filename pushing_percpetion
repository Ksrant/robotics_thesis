# ═══════════════════════════════════════════════════════════════════════════
#  GEOMETRIC GENERALIZATION — Objective 1
# ═══════════════════════════════════════════════════════════════════════════

def best_face_normal(push_dir_xy, theta_o=0.0):
    """
    Cube/rectangle: normal of the face most opposed to the push direction,
    accounting for the object's actual rotation (theta_o, yaw in
    radians). Without this term, the implicit assumption is that the
    object always stays aligned with the world axes — false as soon as it
    tips over. Does NOT depend on the half-sides (just the choice of axis
    [±1,0]/[0,±1]) — the actual distance to the face is computed
    separately by PushController._current_face_offset().
    """
    base = np.array([[1, 0], [-1, 0], [0, 1], [0, -1]], float)
    c, s = np.cos(theta_o), np.sin(theta_o)
    R = np.array([[c, -s], [s, c]])
    candidates = (R @ base.T).T
    return candidates[np.argmin(candidates @ push_dir_xy)]


def get_approach_direction(push_dir_xy, shape_type, theta_o=0.0):
    """
    Direction, from the object's center, toward the pusher's approach
    point (i.e. opposite to push_dir_xy).
      cube/rectangle: snaps to the nearest face axis, accounting for the
                       object's actual yaw.
      cylinder:        continuous radial direction (rotational symmetry).
    """
    if shape_type == "cube":
        return best_face_normal(push_dir_xy, theta_o)
    elif shape_type == "cylinder":
        return -push_dir_xy / (np.linalg.norm(push_dir_xy) + 1e-9)
    else:
        raise ValueError(f"unknown shape_type: {shape_type}")


def get_c_squared(shape_type, half_extent, half_extent_y=None):
    """
    Squared radius of gyration (Lynch & Mason 1996) — diagnostic only.
      cylinder:       c² = R²/2
      cube/rectangle: c² = (a²+b²)/3, a=half-side x, b=half-side y
                       (reduces to 2a²/3 if a=b, the original square case).
    """
    if shape_type == "cube":
        a = half_extent
        b = half_extent_y if half_extent_y is not None else half_extent
        return (a ** 2 + b ** 2) / 3.0
    elif shape_type == "cylinder":
        return half_extent ** 2 / 2.0
    raise ValueError(f"unknown shape_type: {shape_type}")


def contact_point_xy(object_pos_xy, face_normal, offset):
    return object_pos_xy + (offset + SPHERE_RADIUS - 0.005) * face_normal


def hover_point_xy(object_pos_xy, face_normal, offset):
    """Hover point, progressively reduced if out of the arm's reach."""
    for margin in (0.12, 0.08, 0.05, 0.02):
        p = object_pos_xy + (offset + SPHERE_RADIUS + margin) * face_normal
        if np.linalg.norm(p - ROBOT_BASE_XY) <= FRANKA_MAX_REACH_XY:
            return p
    dir_to_base = ROBOT_BASE_XY - object_pos_xy
    safe_dir = dir_to_base / (np.linalg.norm(dir_to_base) + 1e-9)
    return object_pos_xy + (offset + SPHERE_RADIUS + 0.05) * safe_dir


